# Required public tournament page.
TOURNAMENT_URL=http://localhost:3000/tour/your-slug

# Direct public API/backend origins. In production these usually point to Render.
PUBLIC_API_ORIGIN=http://localhost:8080
BACKEND_ORIGIN=http://localhost:8080

# Full capacity stages. Use 1,2 for a local harness smoke test only.
STAGES=100,250,500,750,1000,1500,2000,2500,3000,4000,5000,6000,7000,8000,9000,10000
RAMP_SECONDS=30
SETTLE_SECONDS=10
HOLD_SECONDS=90
SAMPLE_SECONDS=5
STOP_ON_FAIL=true

# Required for real CPU/RAM/GC/Hikari/Tomcat metrics and Render sizing.
LOADTEST_ADMIN_USER=
LOADTEST_ADMIN_PASS=

# Optional real result writes and write-to-SSE fan-out latency.
LOADTEST_STAFF_USER=
LOADTEST_STAFF_PASS=
ACTIVITY_CARD_ID=
ACTIVITY_MATCH_ID=
ACTIVITY_INTERVAL_MS=10000

# Required for every non-local viewer/API/backend/CDN host, comma-separated.
CONFIRM_PRODUCTION_LOAD=

# ---------------------------------------------------------------- Phase H: snapshot cutover
#
# Leave SNAPSHOT_ORIGIN unset for measurement ①: with no CDN there is no probe and no published
# viewer, so the run is the pre-Phase-H baseline by construction. Keep that run's directory and pass
# it as BASELINE_RUN_DIR to the run that follows — ③ and ④ are deltas and cannot be computed without
# it.
SNAPSHOT_ORIGIN=
FLEET=live

# Access tokens of tournaments that ARE published. The run refuses to start if any of them does not
# resolve a snapshot through the public hostname, because every viewer would then fail open onto the
# live path and the zero-Render measurement would be meaningless.
PUBLISHED_TOKENS=
# Live control tournaments. Defaults to the token in TOURNAMENT_URL. Must not overlap the above.
LIVE_TOKENS=
PUBLISHED_VIEWER_SHARE=0.5

# Mirrors the browser's PROBE_TIMEOUT_MS; on by default once SNAPSHOT_ORIGIN is set.
SNAPSHOT_PROBE_ON_LIVE=
SNAPSHOT_PROBE_TIMEOUT_MS=1200

# A previous run directory to compare ① and ③/④ against, e.g. load-testing/results/2026-07-06T13-31-34
BASELINE_RUN_DIR=

# Architecture §2.5 budgets.
THRESHOLD_MAX_PROBE_P95_MS=25
THRESHOLD_MIN_EDGE_HIT_RATIO=0.95
THRESHOLD_MAX_LIVE_FIRST_DATA_REGRESSION_MS=25
